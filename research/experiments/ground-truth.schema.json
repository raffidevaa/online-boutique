{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fault Ground Truth",
  "type": "object",
  "required": [
    "schema_version",
    "experiment_id",
    "scenario_id",
    "root_cause_service",
    "fault_category",
    "fault_type",
    "target_service",
    "injection_start",
    "injection_end",
    "severity"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "experiment_id": {"type": "string", "minLength": 1},
    "scenario_id": {"type": "string", "minLength": 1},
    "root_cause_service": {"type": "string", "minLength": 1},
    "fault_category": {"enum": ["resource", "network", "code_level"]},
    "fault_type": {"type": "string", "minLength": 1},
    "target_service": {"type": "string", "minLength": 1},
    "parameters": {"type": "object"},
    "injection_start": {"type": "string", "format": "date-time"},
    "injection_end": {"type": "string", "format": "date-time"},
    "severity": {"enum": ["low", "medium", "high"]}
  }
}
