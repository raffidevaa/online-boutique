# Copy this file to .env. Never commit the populated .env file.
AIOPS_LLM_PROVIDER=deepseek
AIOPS_LLM_BASE_URL=https://api.deepseek.com
AIOPS_LLM_API_KEY=replace-with-your-deepseek-api-key
AIOPS_LLM_MODEL=deepseek-chat
AIOPS_LLM_TIMEOUT_SECONDS=60

# RCA dashboard, exposed like the frontend/Grafana ports on the private host network.
RESEARCH_GUI_HOST=0.0.0.0
RESEARCH_GUI_PORT=8000
RESEARCH_GUI_AUTH_TOKEN=
